# =============================================================================
# Dockerfile.lite - l'image d'EXECUTION : les binaires, sans les sources
# =============================================================================
#
# osmocom-nitb pese ~11 Go, dont 4 Go de /opt/GSM : les arbres de construction
# de gnuradio, gr-gsm, libosmocore, qemu, osmo-* ... Ces arbres ont servi a
# COMPILER ; ce qui tourne ensuite vit dans /usr/local/bin (119 Mo) et
# /usr/local/lib (17 Mo). Les garder revient a trimballer l'atelier avec la
# machine.
#
# POURQUOI DEUX ETAPES ET UN APLATISSEMENT
# Effacer dans une couche supplementaire ne rend RIEN : une image est la somme
# de ses couches, et les fichiers effaces continuent d'occuper celles d'avant.
# On elague donc dans une etape (prune), puis on recopie la racine obtenue dans
# une image vierge : seule la version elaguee est ecrite, et l'espace est
# reellement rendu.
#
# On repart de la racine COMPLETE plutot que de reconstruire une base a partir
# d'une liste de paquets : les binaires de /usr/local dependent de dizaines de
# bibliotheques posees par apt (boost, volk, fftw, sofia-sip...). Une liste
# reecrite a la main s'en approche, ne les couvre jamais toutes, et la panne
# n'apparait qu'a l'execution - un binaire qui ne demarre pas, faute d'un .so.
# Ici, tout ce qui n'est pas une source reste EXACTEMENT ce qu'il etait.
#
# Ce qui est GARDE dans /opt/GSM : ce que la pile lance vraiment.
#   qemu-src/build/qemu-system-arm            l'emulateur Calypso
#   qemu-src/pc-bios, qemu-src/tools          BIOS et outils appeles au runtime
#   qemu-src/target/firmware/.../compal_e88   layer1 charge dans le telephone
#   osmocom-bb/src/host/osmocon/osmocon       le chargeur
#   osmocom-bb/src/target/trx_toolkit         fake_trx.py et compagnie
#   calypso_dsp.*.bin                         les ROM du DSP
#   firmware/, qemu-install/, osmo_egprs/     images, qemu installe, ce depot
#
# Construction :  ./build.sh --lite      (ou docker build -f Dockerfile.lite .)
# =============================================================================

ARG BASE=osmocom-nitb

# ── Etape 1 : elagage ───────────────────────────────────────────────────────
FROM ${BASE} AS prune

# set -e implicite (SHELL par defaut) : si l'elagage echoue, l'image ne sort pas
# a moitie taillee. Tout se fait dans UNE couche - c'est son etat final qui sera
# recopie, pas les etapes intermediaires.
RUN set -eux; \
    cd /opt/GSM; \
    mkdir -p /keep/qemu-src /keep/osmocom-bb/src/host/osmocon \
             /keep/osmocom-bb/src/target; \
    # Les artefacts a conserver, mis de cote avant la coupe.
    cp -a qemu-src/build/qemu-system-arm  /keep/qemu-src/ 2>/dev/null || true; \
    cp -a qemu-src/pc-bios                /keep/qemu-src/ 2>/dev/null || true; \
    cp -a qemu-src/tools                  /keep/qemu-src/ 2>/dev/null || true; \
    mkdir -p /keep/qemu-src/target/firmware/board; \
    cp -a qemu-src/target/firmware/board/compal_e88 \
          /keep/qemu-src/target/firmware/board/ 2>/dev/null || true; \
    cp -a osmocom-bb/src/host/osmocon/osmocon \
          /keep/osmocom-bb/src/host/osmocon/ 2>/dev/null || true; \
    cp -a osmocom-bb/src/target/trx_toolkit \
          /keep/osmocom-bb/src/target/ 2>/dev/null || true; \
    cp -a *.bin /keep/ 2>/dev/null || true; \
    for d in firmware qemu-install osmo_egprs pont; do \
        [ -e "$d" ] && cp -a "$d" /keep/ || true; \
    done; \
    # La coupe : tout /opt/GSM disparait, seuls les artefacts reviennent.
    cd /; rm -rf /opt/GSM; mkdir -p /opt/GSM; \
    cp -a /keep/. /opt/GSM/; rm -rf /keep; \
    # Reste de l'atelier : en-tetes, bibliotheques statiques, objets, caches.
    rm -rf /usr/local/include /root/.cache /root/.cargo /root/.rustup \
           /usr/share/doc /usr/share/man /usr/share/locale \
           /var/lib/apt/lists/* /var/cache/apt/archives/*.deb \
           /tmp/* /var/tmp/*; \
    find /usr/local/lib -name '*.a' -delete 2>/dev/null || true; \
    find / -xdev -name '*.o' -delete 2>/dev/null || true; \
    du -sh /opt/GSM /usr/local/bin /usr/local/lib

# ── Etape 2 : aplatissement ─────────────────────────────────────────────────
# FROM scratch + COPY de la racine : une seule couche, qui ne contient que
# l'etat elague. C'est ce qui fait reellement tomber la taille.
FROM scratch
COPY --from=prune / /

# La configuration ne traverse pas un FROM scratch : on la redeclare a
# l'identique de l'image d'origine, sinon l'image lite ne demarre pas pareil.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    container=docker \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
    LD_LIBRARY_PATH=/usr/local/lib \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /etc/osmocom
ENTRYPOINT ["/etc/osmocom/entrypoint.sh"]
CMD ["/bin/bash"]
