# =============================================================================
#  environment/paths.env — ou sont les dependances (configuration d'INSTALLATION)
# =============================================================================
#  Repond a une seule question : OU sont les choses sur CETTE machine.
#  Surchargeable depuis l'environnement (idiome `:=`) :
#      GSM_ROOT=/home/moi/gsm ./run.sh
#  Verifier :   ./run.sh --check-paths
# -----------------------------------------------------------------------------

# --- Racine de l'installation -------------------------------------------------
: "${GSM_ROOT:=/opt/GSM}"

# --- Ce depot -----------------------------------------------------------------
: "${NITB_TREE:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
: "${NITB_SCRIPTS:=$NITB_TREE/scripts}"
: "${NITB_CONFIGS:=$NITB_TREE/configs}"
: "${NITB_HELPERS:=$NITB_TREE/helpers}"

# --- L'emulation Calypso (depot voisin) ---------------------------------------
# Le mode « qemu » lui delegue. Cherche a cote, puis a l'emplacement habituel.
if [ -x "$NITB_TREE/../qemu-src/run.sh" ]; then
    : "${OQC_ROOT:=$(cd "$NITB_TREE/../qemu-src" && pwd)}"
else
    : "${OQC_ROOT:=$GSM_ROOT/qemu-src}"
fi

# --- Binaires Osmocom ---------------------------------------------------------
# Vides = cherches dans le PATH, ce qui est le cas d'une installation par paquets.
: "${OSMO_STP:=osmo-stp}"
: "${OSMO_HLR:=osmo-hlr}"
: "${OSMO_MSC:=osmo-msc}"
: "${OSMO_MGW:=osmo-mgw}"
: "${OSMO_BSC:=osmo-bsc}"
: "${OSMO_SGSN:=osmo-sgsn}"
: "${OSMO_GGSN:=osmo-ggsn}"
: "${OSMO_PCU:=osmo-pcu}"
: "${OSMO_BTS_TRX:=osmo-bts-trx}"
: "${OSMO_BTS_VIRTUAL:=osmo-bts-virtual}"
: "${OSMO_TRX_IPC:=osmo-trx-ipc}"
: "${ASTERISK_BIN:=asterisk}"

# --- osmocom-bb (mobile, trxcon, virtphy, fake_trx) ---------------------------
: "${OSMOCOM_BB:=$GSM_ROOT/osmocom-bb}"
: "${MOBILE_BIN:=$OSMOCOM_BB/src/host/layer23/src/mobile/mobile}"
: "${TRXCON_BIN:=$OSMOCOM_BB/src/host/trxcon/trxcon}"
: "${VIRTPHY_BIN:=$OSMOCOM_BB/src/host/virt_phy/src/virtphy}"
: "${FAKE_TRX:=$OSMOCOM_BB/src/target/trx_toolkit/fake_trx.py}"

# --- Configuration Osmocom ----------------------------------------------------
: "${OSMOCOM_CFG:=/etc/osmocom}"
: "${OSMOCOM_HOME:=$HOME/.osmocom}"

# --- Sorties ------------------------------------------------------------------
# Un tiers n'a aucune raison d'ecrire dans /root : RUN_DIR (socket du moniteur,
# fichiers PID — quelques octets, et plusieurs outils les cherchent la) reste
# sous /tmp.
: "${RUN_DIR:=${XDG_RUNTIME_DIR:-/tmp}/osmo-nitb}"

# [2026-08-03] LES JOURNAUX RESTENT SUR LE TMPFS. Arbitrage entre DEUX pannes
# reelles, vecues le meme jour :
#   A — /tmp sature (30/07 x2, 03/08) : compilation qui echoue, journaux perdus.
#       CORRIGE A LA SOURCE : start.sh cree le conteneur avec --tmpfs /tmp:size=2g.
#   B — defilement tmux saccade, provoque par le contournement de A (LOG_DIR sous
#       /root). Bissecte sur le commit 1d241a0 puis confirme par retour arriere.
#       Mecanisme : / est un overlay a 16 couches ou inotify ne remonte pas ;
#       `tail -F` retombe sur du sondage a 1 s et le flux arrive en paquets.
# Les journaux vivent donc sur le tmpfs, seul systeme de fichiers ici ou inotify
# fonctionne. Si le volume redevient un probleme : tarir la SOURCE
# (CALYPSO_INTM_TRANS=0 = 56 %% du flux, CALYPSO_MAILBOX=0), pas deplacer la cible.

: "${LOG_DIR:=$RUN_DIR/logs}"

# --- Pont de nommage avec le depot Calypso ------------------------------------
# Les modules partages entre les deux depots designent l emulation Calypso par
# QEMU_TREE (son nom vu de l interieur). Ici, ce depot est le VOISIN : OQC_ROOT.
# On expose les deux noms pour que les memes modules fonctionnent des deux cotes
# sans etre dupliques.
: "${QEMU_TREE:=$OQC_ROOT}"
: "${QEMU_BIN:=$OQC_ROOT/build/qemu-system-arm}"

# --- Chemins de l emulation Calypso (firmware, ROM DSP, osmocon...) -----------
# Les modules du mode « qemu » sont partages avec le depot voisin et exigent
# FIRMWARE_ELF, DSP_PROM0..3, OSMOCON, QEMU_CFGS... Ces chemins sont decrits par
# le paths.env de ce voisin : on le source plutot que de les redupliquer ici.
# En DERNIER, a dessein : tout ce qui precede a deja pose sa valeur, et l idiome
# `:=` fait que le premier gagne — RUN_DIR/LOG_DIR restent donc ceux du reseau.
if [ -r "$OQC_ROOT/environnement/paths.env" ]; then
    . "$OQC_ROOT/environnement/paths.env"
fi
