!
log stderr
  logging filter all 1
  logging color 1
  logging print category 1
  logging timestamp 0
  logging level lss7 debug
  logging level lsccp debug
  logging level lm3ua debug
!
line vty
 no login
!
cs7 instance 0
 network-indicator international
 point-code __PC_STP__

 ! ── MSC (PC __PC_MSC__) ────────────────────────────────────────────────────
 asp asp-msc 2906 2905 m3ua
  local-ip 127.0.0.1
  remote-ip 127.0.0.1
  role sg
  sctp-role server
  no shutdown
 as as-msc m3ua
  asp asp-msc
  routing-key 1 __PC_MSC__
  traffic-mode override

 ! ── BSC (PC __PC_BSC__) ────────────────────────────────────────────────────
 asp asp-bsc 2907 2905 m3ua
  local-ip 127.0.0.1
  remote-ip 127.0.0.1
  role sg
  sctp-role server
  no shutdown
 as as-bsc m3ua
  asp asp-bsc
  routing-key 3 __PC_BSC__
  traffic-mode override

 ! ── Routes internes ─────────────────────────────────────────────────────────
 route-table system
  update route __PC_MSC__ 7.255.7 linkset as-msc
  update route __PC_BSC__ 7.255.7 linkset as-bsc

 ! ── Connexion vers l'inter-STP (réseau inter-opérateurs) ───────────────────
 ! Actif uniquement en mode bridge (INTER_STP_IP != 127.0.0.1)
 asp asp-inter-stp 2905 2909 m3ua
  remote-ip __INTER_STP_IP__
  local-ip __CONTAINER_IP__
  role asp
  sctp-role client
  no shutdown
 as as-inter m3ua
  asp asp-inter-stp
  routing-key 99 __PC_STP__
  traffic-mode override

 ! ── Serveur d'écoute M3UA (connexions locales MSC/BSC) ─────────────────────
 listen m3ua 2905
