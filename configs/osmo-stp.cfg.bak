!
log stderr
  logging filter all 1
  logging color 1
  logging print category 1
  logging timestamp 0
  logging level lss7 debug
  logging level lsccp debug
  logging level lm3ua debug
!
line vty
 no login
!
cs7 instance 0
 point-code 0.23.2
 network-indicator international

 ! ── Global Title du STP lui-même ───────────────────────────────────────────
 sccp-address addr-stp-gt
  routing-indicator GT
  global-title
   global-title-indicator 4
   translation-type 0
   numbering-plan-indicator 1
   nature-of-address-indicator 4
   digits +33102030400

 ! ── ASP MSC (PC 0.23.1) ────────────────────────────────────────────────────
 asp asp-msc 2906 2905 m3ua
  local-ip 127.0.0.1
  remote-ip 127.0.0.1
  role sg
  sctp-role server
  no shutdown
 as as-msc m3ua
  asp asp-msc
  routing-key 1 0.23.1
  traffic-mode override

 ! ── ASP BSC (PC 0.23.3) ────────────────────────────────────────────────────
 asp asp-bsc 2907 2905 m3ua
  local-ip 127.0.0.1
  remote-ip 127.0.0.1
  role sg
  sctp-role server
  no shutdown
 as as-bsc m3ua
  asp asp-bsc
  routing-key 3 0.23.3
  traffic-mode override

 ! ── ASP SigPloit (PC 0.23.4) ───────────────────────────────────────────────
 asp asp-sigploit 2908 2905 m3ua
  local-ip 127.0.0.1
  remote-ip 127.0.0.1
  role sg
  sctp-role server
  no shutdown
 as as-sigploit m3ua
  asp asp-sigploit
  routing-key 4 0.23.4
  traffic-mode override

 ! ── Routes PC statiques ─────────────────────────────────────────────────────
 route-table system
  update route 0.23.1 7.255.7 linkset as-msc
  update route 0.23.3 7.255.7 linkset as-bsc
  update route 0.23.4 7.255.7 linkset as-sigploit

 ! ── GT Translation (GTT) ────────────────────────────────────────────────────
 ! Traduit les GT entrants vers le PC de destination
 ! GTI=4, TT=0, NP=E.164, NOA=international → résolution par PC
 sccp-address addr-msc-gt
  routing-indicator GT
  point-code 0.23.1
  global-title
   global-title-indicator 4
   translation-type 0
   numbering-plan-indicator 1
   nature-of-address-indicator 4
   digits +33102030401

 sccp-address addr-bsc-gt
  routing-indicator GT
  point-code 0.23.3
  global-title
   global-title-indicator 4
   translation-type 0
   numbering-plan-indicator 1
   nature-of-address-indicator 4
   digits +33102030403

 ! ── Serveur d'écoute M3UA ───────────────────────────────────────────────────
 listen m3ua 2905
