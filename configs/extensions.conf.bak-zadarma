; =============================================================================
; extensions.conf — Asterisk dialplan — Opérateur __OPERATOR_ID__
;
; ┌─────────────────────────────────────────────────────────────────────────┐
; │  PLAN DE NUMÉROTATION                                                   │
; │  100        Linphone A (softphone local)                                │
; │  200        Linphone B (softphone local)                                │
; │  600        Echo test                                                   │
; │  700        Annonce de bienvenue                                        │
; │  NXXXX      Abonnés GSM opérateur N (premier chiffre = identifiant op) │
; ├─────────────────────────────────────────────────────────────────────────┤
; │  CONTEXTES                                                              │
; │  [internal]    Appels depuis softphones locaux                          │
; │  [gsm_in]      Appels entrants depuis OsmoMSC (GSM → Asterisk)         │
; │  [interop_in]  Appels entrants depuis un opérateur distant (SIP trunk)  │
; │  [gsm_out]     Sous-contexte : sortie vers MSC local                   │
; │  [interop_out] Routage vers l'opérateur distant approprié              │
; │                GÉNÉRÉ par start.sh selon le nombre d'opérateurs        │
; └─────────────────────────────────────────────────────────────────────────┘
;
; SCÉNARIOS COUVERTS
; ──────────────────
; 1. MS → MS  (même opérateur)    : MS → MSC → MNCC → Asterisk → MNCC → MSC → MS
; 2. MS → Linphone                 : MS → MSC → Asterisk SIP → Linphone
; 3. Linphone → MS                 : Linphone SIP → Asterisk → MNCC → MSC → MS
; 4. Linphone A → Linphone B       : SIP local
; 5. MS(OpX) → MS(OpY) inter-op   : MNCC → AstX → SIP trunk → AstY → MNCC → MS
; 6. MS → echo / annonce           : test audio
;
; NOTE : [interop_out] est ajouté en fin de fichier par start.sh.
;        Il contient une extension par opérateur distant, routée vers
;        le trunk interop_trunk_opX correspondant.
; =============================================================================

[general]
static=yes
writeprotect=no
clearglobalvars=no

[globals]
MSC_LOCAL=127.0.0.1
OP_PREFIX=__OPERATOR_ID__
; ── Monitoring : enregistrement horodaté de TOUS les appels (yes/no) ──
CALL_RECORDING=yes
RECORDINGS_DIR=/var/spool/asterisk/monitor

; =============================================================================
; [sub-record] — Démarre l'enregistrement (MixMonitor) horodaté de l'appel.
;   Appelé en tête de chaque appel : Gosub(sub-record,s,1(<numéro_appelé>))
;   Fichier : ${RECORDINGS_DIR}/<date>_<heure>_op<N>_<appelant>_to_<appelé>_<uid>.wav
;   Option 'b' : n'enregistre que l'audio pendant que l'appel est ponté.
;   Désactivable globalement via CALL_RECORDING=no.
;   Nécessite app_mixmonitor.so (cf modules.conf).
; =============================================================================
[sub-record]
exten => s,1,GotoIf($["${CALL_RECORDING}" != "yes"]?skip)
 ; L'enregistrement (audiohook) sort le pont du RTP natif → transcodage forcé.
 ; Un jitterbuffer adaptatif lisse le flux pour éviter les pertes de trames
 ; (translate slin→gsm) qui coupaient le son. Nécessite func_jitterbuffer.so.
 same => n,Set(JITTERBUFFER(adaptive)=default)
 same => n,Set(REC_TS=${STRFTIME(${EPOCH},,%Y%m%d_%H%M%S)})
 same => n,Set(REC_NAME=${FILTER(A-Za-z0-9_-,${REC_TS}_op${OP_PREFIX}_${CALLERID(num)}_to_${ARG1}_${UNIQUEID})})
 same => n,MixMonitor(${RECORDINGS_DIR}/${REC_NAME}.wav,b)
 same => n,NoOp(=== REC → ${RECORDINGS_DIR}/${REC_NAME}.wav ===)
 same => n(skip),Return()

; =============================================================================
; [internal] — Appels DEPUIS les softphones locaux
; =============================================================================
[internal]

; ── 500 : lecture audio lithium ─────────────────────────────────────────────
;   Joue /root/lithium.wav du conteneur (WAV 8 kHz mono recommandé).
;   Playback(/root/lithium) sans extension → Asterisk résout /root/lithium.wav.
;   Fichier à fournir dans chaque conteneur (osmo-operator-1 et distant).
exten => 500,1,NoOp(=== LITHIUM - CallerID: ${CALLERID(all)} ===)
 same => n,Answer()
 same => n,Wait(1)
 same => n,Playback(/root/lithium)
 same => n,Hangup()

; ── Tests audio ──────────────────────────────────────────────────────────────
exten => 600,1,NoOp(=== ECHO TEST - CallerID: ${CALLERID(all)} ===)
 same => n,Answer()
 same => n,Playback(demo-echotest)
 same => n,Echo()
 same => n,Playback(demo-echodone)
 same => n,Hangup()

exten => 700,1,NoOp(=== ANNONCE - CallerID: ${CALLERID(all)} ===)
 same => n,Answer()
 same => n,Playback(hello-world)
 same => n,Hangup()

; ── Softphone → Softphone ────────────────────────────────────────────────────
exten => 100,1,NoOp(=== SIP: → Linphone A - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_A,,rT)
 same => n,Congestion()
 same => n,Hangup()

exten => 200,1,NoOp(=== SIP: → Linphone B - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_B,,rT)
 same => n,Congestion()
 same => n,Hangup()

; ── Softphone → GSM local ────────────────────────────────────────────────────
; Numéros opérateur local : __OPERATOR_ID__XXXX
exten => ___OPERATOR_ID__XXXX,1,NoOp(=== SIP -> GSM local (Op__OPERATOR_ID__): ${EXTEN} - CallerID: ${CALLERID(all)} ===)
 same => n,Set(CALLERID(all)=<${CALLERID(num)}>)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc,,rT)
 same => n,Congestion()
 same => n,Hangup()

; ── Softphone → GSM inter-opérateur ──────────────────────────────────────────
; Composer 9 + numéro complet (ex: 920001 pour joindre 20001 sur Op2)
exten => _9.,1,NoOp(=== SIP -> INTER-OP: ${EXTEN:1} - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN:1}))
 same => n,Goto(interop_out,${EXTEN:1},1)

; ── Catch-all : essayer le MSC local ────────────────────────────────────────
exten => _X.,1,NoOp(=== SIP -> GSM fallback: ${EXTEN} - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc,,rT)
 same => n,Congestion()
 same => n,Hangup()

; =============================================================================
; [gsm_in] — Appels entrants DEPUIS OsmoMSC (GSM → Asterisk)
;
; ARCHITECTURE DES PATTERNS (du plus spécifique au moins spécifique) :
;   1. Numéros fixes (100, 200, 600)       → services locaux
;   2. _NXXXX  (5 chiffres, préfixe op)    → MS local même opérateur
;   3. _X.     (catch-all)                  → routage inter-op ou rejet
;
; Asterisk matche le pattern le PLUS SPÉCIFIQUE en premier.
; _NXXXX (5 chars fixes) bat _X. (wildcard) — pas besoin de priorité.
;
; NOTE : les patterns _[0-9][0-9]XXXX et _[0-9]XXXXX sont SUPPRIMÉS
; car ils sont des alias l'un de l'autre (6 chiffres quelconques)
; et causent des conflits de priorité avec Asterisk.
; =============================================================================
[gsm_in]

; ── 500 : lecture audio lithium (/root/lithium.wav du conteneur) ──
exten => 500,1,NoOp(=== GSM -> LITHIUM - CallerID: ${CALLERID(all)} ===)
 same => n,Answer()
 same => n,Wait(1)
 same => n,Playback(/root/lithium)
 same => n,Hangup()

; ── Tests audio ──────────────────────────────────────────────────────────────
exten => 600,1,NoOp(=== GSM -> ECHO TEST - CallerID: ${CALLERID(all)} ===)
 same => n,Answer()
 same => n,Playback(demo-echotest)
 same => n,Echo()
 same => n,Playback(demo-echodone)
 same => n,Hangup()

; ── MS → Linphone ────────────────────────────────────────────────────────────
exten => 100,1,NoOp(=== GSM -> Linphone A - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_A,,rT)
 same => n,Congestion()
 same => n,Hangup()

exten => 200,1,NoOp(=== GSM -> Linphone B - CallerID: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_B,,rT)
 same => n,Congestion()
 same => n,Hangup()

; ── MS → MS local (même opérateur) ───────────────────────────────────────────
; Pattern : __OPERATOR_ID__ suivi de 4 chiffres (ex: 10001 pour Op1)
exten => ___OPERATOR_ID__XXXX,1,NoOp(=== GSM -> GSM local (Op__OPERATOR_ID__): ${EXTEN} - CallerID: ${CALLERID(all)} ===)
 same => n,Set(CALLERID(all)=<${CALLERID(num)}>)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc,,rT)
 same => n,Congestion()
 same => n,Hangup()

; ── Routage inter-opérateur (catch-all) ──────────────────────────────────────
; Tout ce qui n'est pas un numéro local ou un service fixe arrive ici.
; On tente le routage inter-op via [interop_out].
; Si le numéro commence par notre propre préfixe → invalide (évite boucle).
exten => _X.,1,NoOp(=== GSM -> routage inter-op: ${EXTEN} - CallerID: ${CALLERID(all)} ===)
 same => n,GotoIf($["${EXTEN:0:1}" = "__OPERATOR_ID__"]?local_fallback)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Goto(interop_out,${EXTEN},1)
 same => n(local_fallback),NoOp(=== Numéro local non trouvé: ${EXTEN} ===)
 same => n,Congestion()
 same => n,Hangup()

; =============================================================================
; [interop_in] — Appels entrants DEPUIS un opérateur distant (SIP trunk)
; =============================================================================
[interop_in]

; MS distant → MS local
exten => ___OPERATOR_ID__XXXX,1,NoOp(=== INTER-OP -> GSM local: ${EXTEN} - CallerID distant: ${CALLERID(all)} ===)
 same => n,Set(CALLERID(all)=<${CALLERID(num)}>)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc,,rT)
 same => n,Congestion()
 same => n,Hangup()

exten => ___OPERATOR_ID__XXXXX,1,NoOp(=== INTER-OP -> GSM local: ${EXTEN} - CallerID distant: ${CALLERID(all)} ===)
 same => n,Set(CALLERID(all)=<${CALLERID(num)}>)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc,,rT)
 same => n,Congestion()
 same => n,Hangup()
 
; Opérateur distant → Linphone local
exten => 100,1,NoOp(=== INTER-OP -> Linphone A - CallerID distant: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_A,,rT)
 same => n,Hangup()

exten => 200,1,NoOp(=== INTER-OP -> Linphone B - CallerID distant: ${CALLERID(all)} ===)
 same => n,Gosub(sub-record,s,1(${EXTEN}))
 same => n,Dial(PJSIP/linphone_B,,rT)
 same => n,Hangup()

; Refus propre
exten => _X.,1,NoOp(=== INTER-OP -> numéro inconnu: ${EXTEN} - CallerID distant: ${CALLERID(all)} ===)
 same => n,Congestion()
 same => n,Hangup()

; =============================================================================
; [interop_out] — Routage sortant vers les opérateurs distants
;
; Ce contexte est GÉNÉRÉ et AJOUTÉ en fin de fichier par start.sh.
; Il contient une extension _NXXXX par opérateur distant (N ≠ __OPERATOR_ID__)
; qui route vers interop_trunk_opN via PJSIP.
;
; Exemple pour Op1 avec 3 opérateurs :
;   exten => _2XXXX → interop_trunk_op2
;   exten => _3XXXX → interop_trunk_op3
;   exten => _X.    → Congestion
; =============================================================================
