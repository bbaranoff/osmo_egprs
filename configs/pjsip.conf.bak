; =========================================================
; Asterisk PJSIP configuration
; Opérateur __OPERATOR_ID__ — IP : __CONTAINER_IP__
; =========================================================

[global]
type=global
user_agent=Asterisk-OsmoOP__OPERATOR_ID__

[transport-udp]
type=transport
protocol=udp
bind=__CONTAINER_IP__:5060
external_signaling_address=__CONTAINER_IP__
external_media_address=__CONTAINER_IP__

; =========================================================
; Trunk vers Osmo-SIP-Connector (local)
; =========================================================
[trunk-osmo]
type=registration
transport=transport-udp
outbound_auth=auth-osmo
server_uri=sip:127.0.0.1:5061
client_uri=sip:asterisk@127.0.0.1:5061
retry_interval=60

[auth-osmo]
type=auth
auth_type=userpass
username=asterisk
password=osmocom1

[aor-osmo]
type=aor
contact=sip:127.0.0.1:5061
