; ============================
; MACHINE A - extensions.conf
; PJSIP PUR
; ============================

[general]
static=yes
writeprotect=no
clearglobalvars=no

[globals]
CONSOLE=Console/dsp

; ==================================================
; CONTEXTE LOCAL
; Appels depuis Linphone
; ==================================================

[internal]

; --- Tests ---
exten => 600,1,Playback(demo-echotest)
 same => n,Echo
 same => n,Playback(demo-echodone)
 same => n,Hangup()

; --- Linphone A -> Linphone B ---
exten => 200,1,NoOp(Linphone A -> Linphone B)
 same => n,Dial(PJSIP/linphone_B)
 same => n,Hangup()

; --- Linphone B -> Linphone A ---
exten => 100,1,NoOp(Linphone B -> Linphone A)
 same => n,Dial(PJSIP/linphone_A)
 same => n,Hangup()

; --- Linphone -> GSM local ---
exten => _XXXXX,1,NoOp(Linphone -> GSM local)
 same => n,Dial(PJSIP/${EXTEN}@gsm_msc)
 same => n,Hangup()


; ==================================================
; GSM ENTRANT
; ==================================================

[gsm_subscriber]

; GSM -> Linphone A
exten => 100,1,NoOp(GSM -> Linphone A)
 same => n,Dial(PJSIP/linphone_A)
 same => n,Hangup()

; GSM -> Linphone B
exten => 200,1,NoOp(GSM -> Linphone B)
 same => n,Dial(PJSIP/linphone_B)
 same => n,Hangup()

; GSM -> défaut
exten => _XXXXX,1,Goto(gsm_dispatch,${EXTEN},1)


; ==================================================
; DISPATCH GSM
; ==================================================

[gsm_dispatch]

; GSM -> Linphone A par défaut
exten => _XXXXX,1,NoOp(GSM -> Linphone A (default))
 same => n,Dial(PJSIP/linphone_A)
 same => n,Hangup()
